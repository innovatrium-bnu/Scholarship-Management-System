APP_NAME="BNU Scholarships"

# Safe by default, because this file is the template a deployment is built from
# and nothing copies it automatically -- somebody does, by hand, once, and then
# never looks at these two lines again.
#
# APP_DEBUG=true puts the stack trace, the failing SQL, its bind values and the
# database host, port and name into the body of any 500, returned to whoever
# made the request. It shipped as true here, so a deployment following the repo
# inherited it.
#
# APP_ENV also matters, and less obviously: DemoSeeder refuses to run only in
# production, so an installation left on `local` can have two thousand invented
# students inserted into a real register by a bare `db:seed`.
#
# For local development set APP_ENV=local and APP_DEBUG=true. You will want the
# traces, and the demo register will not seed without the first line.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# "db" is the compose service name. Running artisan outside Docker means
# changing this to 127.0.0.1, which the port mapping in docker-compose.yml
# exposes for exactly that reason.
DB_CONNECTION=oracle
DB_HOST=db
DB_PORT=1521
# The service name of the pluggable database, not a database file — Oracle has
# no equivalent of the Postgres database this used to name. ORCLPDB1 is what
# the container-registry.oracle.com enterprise image calls its PDB; BNU's
# instance will name its own.
DB_DATABASE=ORCLPDB1
DB_USERNAME=bnu
DB_PASSWORD=bnu

# Both have correct defaults in config/database.php and are only worth setting
# if BNU's instance turns out not to match what we assume. Listed because
# getting either wrong fails quietly rather than loudly: DB_SERVER_VERSION
# decides which options reach the TNS descriptor, and ORA_MAX_NAME_LEN must
# stay at 128 on 19c — the package's own default of 30 truncates generated
# index, sequence and trigger names into collisions.
# DB_SERVER_VERSION=19c
# ORA_MAX_NAME_LEN=128

# Cookie sessions, not tokens: the SPA is served from the same origin, so
# Sanctum's session cookie is first-party and there is no token to store where
# a script could read it.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Origins allowed to hold a session cookie. In development the Vite dev server
# runs on 8080 while nginx serves the API on 8000, which is the one case where
# the SPA and the API are not the same origin.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:8080,127.0.0.1:8000,127.0.0.1:8080
FRONTEND_URL=http://localhost:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

