# Line endings
#
# Deliberately narrow. There is no `* text=auto` here, because adding it to an
# existing repository renormalizes every tracked file and produces one enormous
# diff that hides real changes. Only the files that actually break with the
# wrong line endings are listed.

# Shell scripts and git hooks must keep Unix line endings. A script saved with
# CRLF fails with "bad interpreter: no such file or directory", which gives no
# hint about the real cause.
*.sh            text eol=lf
.githooks/*     text eol=lf

# Generated by the TanStack Router plugin on every dev run. Marking it as
# generated keeps it collapsed in diffs and out of the way during review, since
# reviewing it serves no purpose.
src/routeTree.gen.ts    linguist-generated=true

# Lockfile: one authority, never merged by hand.
package-lock.json       merge=binary linguist-generated=true

# Never let git alter these.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.pdf           binary
